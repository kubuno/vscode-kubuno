{
  "comments": { "blockComment": ["<!--", "-->"] },
  "brackets": [["<!--", "-->"], ["<", ">"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [["\"", "\""], ["{", "}"], ["<", ">"]],
  "wordPattern": "[A-Za-z_:][\w:.-]*"
}
