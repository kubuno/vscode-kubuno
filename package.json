{
  "name": "vscode-kubuno",
  "displayName": "Kubuno",
  "description": "Design and edit Kubuno views (.kbview / .kbcontrol) in Visual Studio Code on any OS: visual designer, Toolbox, Properties, the Kubuno views language server.",
  "version": "0.1.0",
  "publisher": "kubuno",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/kubuno/vscode-kubuno",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubuno/vscode-kubuno.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "kubuno",
    "kbview",
    "designer",
    "xml"
  ],
  "icon": "media/kubuno.png",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the designer, Toolbox and Properties work; the views language server (an executable) is not started.",
      "restrictedConfigurations": [
        "kubuno.languageServer.path",
        "kubuno.designer.hostRuntimePath",
        "kubuno.dev.cargoTargetDir",
        "kubuno.dev.folder",
        "kubuno.dev.buildEnv"
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:**/kubuno.views.json",
    "workspaceContains:**/module.toml",
    "onDebugResolve:kubuno",
    "onDebugDynamicConfigurations:kubuno"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kbview",
        "aliases": [
          "Kubuno View",
          "kbview"
        ],
        "extensions": [
          ".kbview",
          ".kbcontrol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kbview",
        "scopeName": "text.xml.kbview",
        "path": "./syntaxes/kbview.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "kubuno.viewDesigner",
        "displayName": "Kubuno View Designer",
        "selector": [
          {
            "filenamePattern": "*.kbview"
          },
          {
            "filenamePattern": "*.kbcontrol"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kubuno",
          "title": "Kubuno",
          "icon": "media/kubuno-activity.svg"
        }
      ]
    },
    "views": {
      "kubuno": [
        {
          "id": "kubuno.explorer",
          "name": "Projects",
          "icon": "media/kubuno-activity.svg"
        },
        {
          "type": "webview",
          "id": "kubuno.toolbox",
          "name": "Toolbox"
        },
        {
          "type": "webview",
          "id": "kubuno.properties",
          "name": "Properties"
        }
      ]
    },
    "commands": [
      {
        "command": "kubuno.openDesigner",
        "title": "Open in Kubuno View Designer",
        "category": "Kubuno",
        "icon": "$(layout)"
      },
      {
        "command": "kubuno.openXml",
        "title": "Open XML Beside",
        "category": "Kubuno",
        "icon": "$(code)"
      },
      {
        "command": "kubuno.toggleCodeBehind",
        "title": "View Code / View Designer",
        "category": "Kubuno",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kubuno.createDefaultHandler",
        "title": "Create Default Event Handler for the Selection",
        "category": "Kubuno"
      },
      {
        "command": "kubuno.deleteSelection",
        "title": "Delete Selected Element",
        "category": "Kubuno"
      },
      {
        "command": "kubuno.selectParent",
        "title": "Select Parent Element",
        "category": "Kubuno"
      },
      {
        "command": "kubuno.restartLanguageServer",
        "title": "Restart the Views Language Server",
        "category": "Kubuno"
      },
      {
        "command": "kubuno.refreshExplorer",
        "title": "Refresh",
        "category": "Kubuno",
        "icon": "$(refresh)"
      },
      {
        "command": "kubuno.newView",
        "title": "New View or User Control…",
        "category": "Kubuno",
        "icon": "$(new-file)"
      },
      {
        "command": "kubuno.showOutput",
        "title": "Show Output",
        "category": "Kubuno"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kubuno.openXml",
          "when": "activeCustomEditorId == kubuno.viewDesigner",
          "group": "navigation@1"
        },
        {
          "command": "kubuno.toggleCodeBehind",
          "when": "activeCustomEditorId == kubuno.viewDesigner || resourceExtname == .kbview || resourceExtname == .kbcontrol",
          "group": "navigation@2"
        },
        {
          "command": "kubuno.openDesigner",
          "when": "(resourceExtname == .kbview || resourceExtname == .kbcontrol) && activeCustomEditorId != kubuno.viewDesigner",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "kubuno.refreshExplorer",
          "when": "view == kubuno.explorer",
          "group": "navigation"
        },
        {
          "command": "kubuno.newView",
          "when": "view == kubuno.explorer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "kubuno.openDesigner",
          "when": "resourceExtname == .kbview || resourceExtname == .kbcontrol",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kubuno.toggleCodeBehind",
        "key": "f7",
        "when": "activeCustomEditorId == kubuno.viewDesigner || resourceExtname == .kbview || resourceExtname == .kbcontrol"
      },
      {
        "command": "kubuno.openDesigner",
        "key": "shift+f7",
        "when": "editorTextFocus && resourceExtname =~ /\\.(kbview|kbcontrol|ts)$/"
      }
    ],
    "configuration": {
      "title": "Kubuno",
      "properties": {
        "kubuno.languageServer.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `kubuno-views-ls` executable. Empty: the one shipped with the extension for this platform, else `kubuno-views-ls` on the `PATH`. Without it, the designer falls back to its built-in XML editor (no completion, handlers written by the extension)."
        },
        "kubuno.designer.openXmlBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open the view's XML in a text editor beside the designer (the Design | XML split)."
        },
        "kubuno.designer.palette": {
          "type": "boolean",
          "default": true,
          "description": "Show the Toolbox docked beside the design surface (drag and drop onto the surface works from there)."
        },
        "kubuno.designer.hostRuntimePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder of a `@kubuno/host-runtime` build (`dist/`) to use instead of the one shipped with the extension."
        },
        "kubuno.dev.port": {
          "type": "number",
          "default": 18680,
          "description": "HTTP port of the dev core (kept away from an installed core on 8080)."
        },
        "kubuno.dev.databaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Database of the dev core: a **throw-away** `postgres://` or `mysql://` URL. Empty: SQLite, one file per schema in the dev core folder."
        },
        "kubuno.dev.folder": {
          "type": "string",
          "default": "",
          "description": "Data folder of the dev core. Empty: the extension's storage (dev-core-<port>)."
        },
        "kubuno.dev.cargoTargetDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "`CARGO_TARGET_DIR` of the build tasks (e.g. a local disk when the sources are on a network share). Empty: Cargo's default."
        },
        "kubuno.dev.debugger": {
          "type": "string",
          "enum": [
            "auto",
            "lldb",
            "cppvsdbg",
            "cppdbg"
          ],
          "default": "auto",
          "description": "Native debugger of the dev core. auto: CodeLLDB, else cppvsdbg (Windows) / cppdbg (gdb)."
        },
        "kubuno.dev.browser": {
          "type": "string",
          "enum": [
            "chrome",
            "edge"
          ],
          "default": "chrome",
          "description": "Browser of the « web (browser) » launch configuration."
        },
        "kubuno.dev.openBrowser": {
          "type": "boolean",
          "default": true,
          "description": "Open the module's page once the dev core answers."
        },
        "kubuno.dev.adminPassword": {
          "type": "string",
          "default": "",
          "description": "Password of the dev core's first admin (admin@kubuno.local). Empty: generated, written to initial-admin-password in the dev core folder."
        },
        "kubuno.dev.rustLog": {
          "type": "string",
          "default": "info",
          "description": "RUST_LOG of the dev core."
        },
        "kubuno.dev.buildEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Extra environment of the build tasks, e.g. `{\"CARGO_INCREMENTAL\": \"0\", \"CARGO_PROFILE_DEV_DEBUG\": \"1\"}` to keep debug builds small (breakpoints still work)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "kubuno",
        "required": [
          "action",
          "target"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "cargo-build",
              "npm-ci",
              "web-build",
              "web-typecheck",
              "prepare-dev-core"
            ],
            "description": "What the task does."
          },
          "target": {
            "type": "string",
            "description": "`core` or a module id (the `[module].id` of its module.toml)."
          },
          "release": {
            "type": "boolean",
            "description": "cargo build --release."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "kubuno-rustc",
        "owner": "rust",
        "source": "cargo",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(warning|warn|error)(?:\\[(\\S+)\\])?: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s+(.+?):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      },
      {
        "name": "kubuno-tsc",
        "owner": "typescript",
        "source": "ts",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^\\s].*?)\\((\\d+),(\\d+)\\): (error|warning|info) (TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "debuggers": [
      {
        "type": "kubuno",
        "label": "Kubuno",
        "languages": [
          "rust",
          "typescript"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "target": {
                "type": "string",
                "enum": [
                  "core",
                  "browser"
                ],
                "default": "core",
                "description": "`core`: the dev core with the module, under CodeLLDB / cppvsdbg / gdb. `browser`: the module's page in a debugged browser (TypeScript breakpoints)."
              },
              "module": {
                "type": "string",
                "description": "The module run with the core (its id)."
              },
              "port": {
                "type": "number",
                "description": "Port of the dev core (default: kubuno.dev.port)."
              },
              "openBrowser": {
                "type": "boolean",
                "default": true,
                "description": "Open the module's page once the core answers."
              },
              "trace": {
                "type": [
                  "boolean",
                  "object"
                ],
                "default": false,
                "description": "Browser target: js-debug tracing (its log file is named in the debug console)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "kubuno",
            "request": "launch",
            "name": "Kubuno: dev core + drive",
            "target": "core",
            "module": "drive"
          },
          {
            "type": "kubuno",
            "request": "launch",
            "name": "Kubuno: drive web (browser)",
            "target": "browser",
            "module": "drive"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Kubuno: dev core with a module",
            "body": {
              "type": "kubuno",
              "request": "launch",
              "name": "Kubuno: dev core + ${1:drive}",
              "target": "core",
              "module": "${1:drive}"
            }
          },
          {
            "label": "Kubuno: module web in the browser",
            "body": {
              "type": "kubuno",
              "request": "launch",
              "name": "Kubuno: ${1:drive} web (browser)",
              "target": "browser",
              "module": "${1:drive}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "pretest": "node esbuild.mjs && tsc -p test",
    "test": "node out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@kubuno/host-runtime": "0.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.1.0",
    "typescript": "^5.7.3"
  }
}
